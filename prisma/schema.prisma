generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id   String @id @default(cuid()) 
  clerk_userId String @unique
  email   String @unique
  createdAt DateTime @default(now())
  qualification Qualification?
}
enum BookingStatus {
  SUBMITTED
  BOOKED
  COMPLETED

}
model Qualification{
  id   String @id @default(cuid())
  name String 
  email String
  budget String
  company String
  description String  
  status  BookingStatus @default(SUBMITTED) 
  isAgreed Boolean      @default(true)
  userId     String  @unique
  user    User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  scheduledMeeting ScheduledMeeting[]

}
enum MeetingStatus {
   SCHEDULED 
   CANCELLED
   ENDED
}
model ScheduledMeeting{
  id String @id @default(cuid()) @unique
  email String
  name String
  scheduledDate DateTime
  status  MeetingStatus @default(SCHEDULED)
  meetingLink String
  qualificationId String @unique
  qualication Qualification @relation(fields: [qualificationId], references: [id])
  createdAt DateTime @default(now()) 


}
    
